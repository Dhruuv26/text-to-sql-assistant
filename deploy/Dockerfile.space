# Single-container, CPU-only image for a free Hugging Face Docker Space (see docs/DEPLOY.md).
# Verify with the manual "Space image (manual)" GitHub Actions workflow before pushing to a Space.
FROM ollama/ollama:latest
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Hugging Face runs Spaces as UID 1000. The Ubuntu base image already has a user "ubuntu" with that UID: remove it first.
RUN (userdel -r ubuntu 2>/dev/null || true) \
    && useradd -m -u 1000 user \
    && mkdir -p /models /srv && chown user:user /models /srv
USER user
WORKDIR /srv

COPY --chown=user:user requirements.txt .
RUN python3 -m venv /home/user/venv && /home/user/venv/bin/pip install --no-cache-dir -r requirements.txt

# Bake the model into the image (owned by "user" from the start, so no chown copy of 2 GB) so cold starts do not download it.
ENV OLLAMA_MODELS=/models MODEL=qwen2.5-coder:3b OLLAMA_HOST=http://127.0.0.1:11434
RUN (ollama serve >/dev/null 2>&1 & pid=$!; \
     for i in $(seq 1 60); do ollama list >/dev/null 2>&1 && break; sleep 1; done; \
     ollama pull "$MODEL"; kill $pid; sleep 2)

COPY --chown=user:user app ./app
COPY --chown=user:user guardrails ./guardrails
COPY --chown=user:user data ./data
COPY --chown=user:user deploy/start.sh ./start.sh
RUN chmod +x /srv/start.sh

ENV PATH="/home/user/venv/bin:$PATH" TRUST_PROXY=1 DEFAULT_APPROACH=zero_shot \
    MAX_CONCURRENT=1 LLM_TIMEOUT_S=120 QUEUE_WAIT_S=60 RATE_PER_MINUTE=4 RATE_PER_DAY=100 OLLAMA_NUM_PARALLEL=1
EXPOSE 7860
ENTRYPOINT []
CMD ["/srv/start.sh"]
